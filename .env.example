# 서버 포트
PORT=3000

# 국가법령정보센터 Open API 인증키(OC). 등록한 IP의 PC에서 서버를 실행하세요.
LAW_OC=

# ── RAG 챗봇
# OpenRouter API 키 (OpenAI 호환). 노출되면 https://openrouter.ai/keys 에서 재발급하세요.
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-4.1-mini
# 규정 문서 폴더 (.hwp/.hwpx). 문서를 바꾸면 npm run ingest 다시 실행
RAG_DOCS_DIR=docs/regulations
# 검색 파라미터 (평가 결과로 정한 기본값)
RAG_CANDIDATES=20
RAG_TOP_K=5
RAG_MIN_SCORE=0.05
RAG_RERANK=on
# 임베딩·리랭커 CPU 스레드 수
MODEL_THREADS=10

# ── 사내 알림 (사규·법령 개정 정기 확인, KST)
NOTIFY_SCHEDULE=on
REG_CHECK_TIME=07:00
# 법령 확인 요일 (0=일, 1=월 … 6=토)
LAW_CHECK_DAY=1
LAW_CHECK_TIME=07:00
